# Rate Limiting Configuration
# Copy these variables to your .env file and adjust as needed

# Global Rate Limiting Settings
RATE_LIMITING_ENABLED=true
RATE_LIMITING_LOG_VIOLATIONS=true
RATE_LIMITING_MAX_SUSPENSION_TIME=3600

# Registration Rate Limiting
RATE_LIMITING_REGISTER_ENABLED=true
RATE_LIMITING_REGISTER_GROWTH=linear
RATE_LIMITING_REGISTER_GLOBAL_ENABLED=true
RATE_LIMITING_REGISTER_GLOBAL_MAX_ATTEMPTS=150
RATE_LIMITING_REGISTER_EMAIL_ENABLED=true
RATE_LIMITING_REGISTER_EMAIL_MAX_ATTEMPTS=3
RATE_LIMITING_REGISTER_IP_ENABLED=true
RATE_LIMITING_REGISTER_IP_MAX_ATTEMPTS=3

# Login Rate Limiting
RATE_LIMITING_LOGIN_ENABLED=true
RATE_LIMITING_LOGIN_GROWTH=linear
RATE_LIMITING_LOGIN_GLOBAL_ENABLED=false
RATE_LIMITING_LOGIN_GLOBAL_MAX_ATTEMPTS=1000
RATE_LIMITING_LOGIN_USERNAME_IP_ENABLED=true
RATE_LIMITING_LOGIN_USERNAME_IP_MAX_ATTEMPTS=5
RATE_LIMITING_LOGIN_IP_ENABLED=true
RATE_LIMITING_LOGIN_IP_MAX_ATTEMPTS=10

# Forgot Password Rate Limiting
RATE_LIMITING_FORGOT_PASSWORD_ENABLED=true
RATE_LIMITING_FORGOT_PASSWORD_GROWTH=linear
RATE_LIMITING_FORGOT_PASSWORD_GLOBAL_ENABLED=false
RATE_LIMITING_FORGOT_PASSWORD_GLOBAL_MAX_ATTEMPTS=500
RATE_LIMITING_FORGOT_PASSWORD_EMAIL_ENABLED=true
RATE_LIMITING_FORGOT_PASSWORD_EMAIL_MAX_ATTEMPTS=3
RATE_LIMITING_FORGOT_PASSWORD_IP_ENABLED=true
RATE_LIMITING_FORGOT_PASSWORD_IP_MAX_ATTEMPTS=5

# Two-Factor Authentication Rate Limiting
RATE_LIMITING_TWO_FACTOR_ENABLED=true
RATE_LIMITING_TWO_FACTOR_GROWTH=fibonacci
RATE_LIMITING_TWO_FACTOR_GLOBAL_ENABLED=false
RATE_LIMITING_TWO_FACTOR_GLOBAL_MAX_ATTEMPTS=1000
RATE_LIMITING_TWO_FACTOR_SESSION_ENABLED=true
RATE_LIMITING_TWO_FACTOR_SESSION_MAX_ATTEMPTS=5
RATE_LIMITING_TWO_FACTOR_IP_ENABLED=true
RATE_LIMITING_TWO_FACTOR_IP_MAX_ATTEMPTS=10

# Custom Messages
RATE_LIMITING_REGISTER_GLOBAL_MESSAGE="Too many registration attempts across the system. Please wait :minutes minutes before trying again."
RATE_LIMITING_REGISTER_EMAIL_MESSAGE="Too many registration attempts with this email address. Please wait :minutes minutes before trying again."
RATE_LIMITING_REGISTER_IP_MESSAGE="Too many registration attempts from your location. Please wait :minutes minutes before trying again."

RATE_LIMITING_LOGIN_GLOBAL_MESSAGE="Too many login attempts across the system. Please wait :minutes minutes before trying again."
RATE_LIMITING_LOGIN_USERNAME_IP_MESSAGE="Too many login attempts with this username from your location. Please wait :minutes minutes before trying again."
RATE_LIMITING_LOGIN_IP_MESSAGE="Too many login attempts from your location. Please wait :minutes minutes before trying again."

RATE_LIMITING_FORGOT_PASSWORD_GLOBAL_MESSAGE="Too many password reset attempts across the system. Please wait :minutes minutes before trying again."
RATE_LIMITING_FORGOT_PASSWORD_EMAIL_MESSAGE="Too many password reset attempts for this email address. Please wait :minutes minutes before trying again."
RATE_LIMITING_FORGOT_PASSWORD_IP_MESSAGE="Too many password reset attempts from your location. Please wait :minutes minutes before trying again."

RATE_LIMITING_TWO_FACTOR_GLOBAL_MESSAGE="Too many two-factor authentication attempts across the system. Please wait :minutes minutes before trying again."
RATE_LIMITING_TWO_FACTOR_SESSION_MESSAGE="Too many two-factor authentication attempts for this session. Please wait :minutes minutes before trying again."
RATE_LIMITING_TWO_FACTOR_IP_MESSAGE="Too many two-factor authentication attempts from your location. Please wait :minutes minutes before trying again."

RATE_LIMITING_DEFAULT_MESSAGE="Too many attempts. Please wait :minutes minutes before trying again."

# Warning Messages
RATE_LIMITING_WARNING_BASE_MESSAGE="You have :attempts attempt(s) remaining before a temporary lockout."
RATE_LIMITING_WARNING_LOGIN_SUGGESTION="If you've forgotten your password, consider using the \"Reset Password\" link below."
RATE_LIMITING_WARNING_REGISTER_SUGGESTION="Please double-check your information before submitting."
RATE_LIMITING_WARNING_FORGOT_PASSWORD_SUGGESTION="Please verify the email address is correct."
RATE_LIMITING_WARNING_TWO_FACTOR_SUGGESTION="Double-check your authenticator app or recovery code."
RATE_LIMITING_WARNING_DEFAULT_SUGGESTION="Please verify your information before continuing."

# Suggestion Messages
RATE_LIMITING_LOGIN_HIGH_ATTEMPTS_SUGGESTION="Consider resetting your password if you've forgotten it, or contact support if you believe this is an error."
RATE_LIMITING_LOGIN_LOW_ATTEMPTS_SUGGESTION="Please double-check your email and password."
RATE_LIMITING_REGISTER_SUGGESTION="Please verify all required fields are filled correctly and try again later."
RATE_LIMITING_FORGOT_PASSWORD_SUGGESTION="Please ensure the email address is correct and check your spam folder for previous reset emails."
RATE_LIMITING_TWO_FACTOR_HIGH_ATTEMPTS_SUGGESTION="If you're having trouble with your authenticator, try using a recovery code instead."
RATE_LIMITING_TWO_FACTOR_LOW_ATTEMPTS_SUGGESTION="Please check your authenticator app for the current code."
RATE_LIMITING_DEFAULT_SUGGESTION="Please wait before trying again."