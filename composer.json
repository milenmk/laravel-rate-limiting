{
    "name": "milenmk/laravel-rate-limiting",
    "description": "Advanced rate limiting package for Laravel with exponential backoff, custom messages, and Blade components",
    "license": "MIT",
    "keywords": [
        "laravel",
        "rate-limiting",
        "throttling",
        "security",
        "backoff",
        "authentication"
    ],
    "authors": [
        {
            "name": "Milen Karaganski",
            "email": "milenmk@gmail.com"
        }
    ],
    "repository": [
        {
            "type": "git",
            "url": "https://github.com/milenmk/laravel-rate-limiting.git"
        }
    ],
    "require": {
        "php": "^8.2|^8.3|^8.4",
        "illuminate/cache": "^10.0|^11.0|^12.0",
        "illuminate/config": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/view": "^10.0|^11.0|^12.0"
    },
    "suggest": {
        "laravel/fortify": "^1.13 - For automatic username field detection in authentication forms"
    },
    "require-dev": {
        "brianium/paratest": "^7.8",
        "laravel/pint": "^1.0",
        "mockery/mockery": "^1.4.4",
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpstan/phpstan": "^1.0",
        "phpunit/phpunit": "^10.0|^11.0",
        "squizlabs/php_codesniffer": "^3.13",
        "tightenco/duster": "^3.2"
    },
    "autoload": {
        "psr-4": {
            "Milenmk\\LaravelRateLimiting\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Milenmk\\LaravelRateLimiting\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Milenmk\\LaravelRateLimiting\\Providers\\RateLimitingServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true
    },
    "conflict": {
        "laravel/framework": "<10.0"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
